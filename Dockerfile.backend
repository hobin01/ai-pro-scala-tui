FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /uvx /usr/local/bin/
COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --extra integrations \
    && useradd --create-home --shell /usr/sbin/nologin scala \
    && mkdir -p /data/chroma \
    && chown -R scala:scala /data

ENV PATH="/app/.venv/bin:$PATH"

USER scala
EXPOSE 8765

CMD ["scala-backend", "serve"]
